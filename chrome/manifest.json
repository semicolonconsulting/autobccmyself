{
  "manifest_version": 3,
  "name": "Auto BCC Myself for Gmail",
  "version": "2.0.0",
  "description": "Adds your own address as Bcc to every Gmail message you write, so threads you send stay in your inbox.",
  "minimum_chrome_version": "102",

  "permissions": ["storage"],

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto BCC Myself for Gmail",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
